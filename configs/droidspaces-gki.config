# Kernel configuration fragment for full DroidSpaces support on GKI kernels
# Source: ravindu644/Droidspaces-OSS — Documentation/Kernel-Configuration.md
# Applies to GKI 5.10 (marble) — safe to use ONLY together with the mandatory
# kABI patches (sysvipc kABI fix + posix_mqueue abi padding), which this repo
# already carries natively per the "reverse-check" confirmation in the build log.
#
# Do NOT add options beyond this list for GKI targets — anything outside this
# set (e.g. CONFIG_NAMESPACES, CONFIG_UTS_NS, CONFIG_CGROUPS, CONFIG_SECCOMP,
# CONFIG_FAIR_GROUP_SCHED) is only safe on non-GKI/legacy kernels and can shift
# task_struct offsets, breaking prebuilt Qualcomm vendor .ko modules.

# IPC
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# HW Access Support
CONFIG_DEVTMPFS=y

# Networking (Enhanced NAT support)
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# --- Below configs are optional but recommended ---

# Fix for docker unsafe procfs error
CONFIG_USER_NS=y

# UFW support
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# Fail2ban support
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# Enable xattr, posix acl support on tmpfs (NixOS support)
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
